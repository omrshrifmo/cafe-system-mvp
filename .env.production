# ====================================================================
# MAZAJ POS & ERP - Production Environment Configuration Template
# ====================================================================
# Configure these variables before building and deploying the Windows .exe

# 1. Supabase / Remote Licensing Server Endpoint
LICENSE_SERVER_URL="https://your-supabase-url.supabase.co/rest/v1/licenses"

# 2. Permanent Cloudflare Named Tunnel Token (Zero Trust Dashboard)
CLOUDFLARE_TUNNEL_TOKEN="your_permanent_cloudflare_token_here"

# 3. Environment Mode
NODE_ENV="production"
PORT=3000

{
  "name": "Claude Skills — task drift re-proposal",
  "description": "Managed by Claude Skills Manager (claude-skills-task-drift)",
  "version": "1",
  "enabled": true,
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "runCommand",
    "command": "curl -sf -X POST -H \"Content-Type: application/json\" --data @- \"http://127.0.0.1:4895/hook/task-drift?agent=kiro&cwd=%2Fhome%2Fomrshrifmo%2Fcafe-system-mvp\" || true",
    "timeout": 8
  }
}

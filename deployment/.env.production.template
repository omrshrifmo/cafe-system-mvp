# Cafe System ERP — Production Environment Variable Template
#
# INSTRUCTIONS:
# 1. Copy this file to .env.production (outside version control)
# 2. Fill in all values marked with <GENERATE_STRONG_SECRET>
# 3. Never commit .env.production to git
# 4. In production, prefer systemd EnvironmentFile or a secret manager (AWS SSM, GCP Secret Manager)
#
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ====================
# Core Configuration
# ====================
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# ====================
# Database
# ====================
# NEVER use the development db path in production
DB_PATH=/data/production/cafe.db

# ====================
# Session Security
# ====================
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<GENERATE_STRONG_SECRET>
SESSION_TTL_HOURS=8

# ====================
# Backup Encryption
# ====================
# Must be a strong random key — used for AES-256-GCM backup encryption
BACKUP_ENCRYPTION_KEY=<GENERATE_STRONG_SECRET>

# Off-site backup destination (configure your S3 bucket or rsync target)
# BACKUP_OFFSITE_DESTINATION=s3://your-cafe-backups-bucket/cafe-system/

# ====================
# Update Package Signing
# ====================
# Must match the key used to sign update packages in your release pipeline
PACKAGE_SIGNING_KEY=<GENERATE_STRONG_SECRET>

# ====================
# CORS / Origin Policy
# ====================
# Comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=https://cafe.example.com

# ====================
# Logging
# ====================
LOG_LEVEL=info

# ====================
# Security / Features
# ====================
# Set to false to disable factory reset in production (recommended)
ALLOW_FACTORY_RESET=false

# Set to false to hide full DB path from /api/build-info (recommended in production)
EXPOSE_DATABASE_PATH=false

# ====================
# Incident Contacts
# ====================
INCIDENT_CONTACT_EMAIL=ops@cafe.example.com
INCIDENT_CONTACT_PHONE=+1234567890
INCIDENT_ESCALATION_EMAIL=cto@cafe.example.com

# ====================
# Additional Options (Optional)
# ====================
# Disable mDNS discovery in production (not needed for internet deployment)
ENABLE_MDNS=false

# Bcrypt work factor (higher = slower but more secure)
BCRYPT_WORK_FACTOR=12
